<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Shield + Heart icon
        Safe zone: 18–90 (72×72dp centred in 108×108dp).
        Shield: 28–80 wide (52dp), 22–82 tall (60dp), centred at (54, 52).
        Heart cutout: 42–66 wide (24dp), 38–61 tall (23dp).
    -->

    <!-- Soft drop shadow: shield shifted down 3dp, 22% opacity -->
    <path
        android:fillColor="#000000"
        android:alpha="0.22"
        android:pathData="
            M 32,25 L 76,25
            Q 80,25 80,29
            L 80,55
            C 80,69 65,80 54,85
            C 43,80 28,69 28,55
            L 28,29
            Q 28,25 32,25
            Z" />

    <!-- Shield body with heart cut-out (evenOdd = heart becomes transparent) -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#F2CCDC"
        android:pathData="
            M 32,22
            L 76,22
            Q 80,22 80,26
            L 80,52
            C 80,66 65,77 54,82
            C 43,77 28,66 28,52
            L 28,26
            Q 28,22 32,22
            Z

            M 54,61
            C 50,57 42,52 42,46
            C 42,40 47,38 50,41
            C 52,42 53,44 54,47
            C 55,44 56,42 58,41
            C 61,38 66,40 66,46
            C 66,52 58,57 54,61
            Z" />

    <!-- Subtle highlight: thin inner rim on shield top, adds depth -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:alpha="0.18"
        android:pathData="
            M 32,22
            L 76,22
            Q 80,22 80,26
            L 80,52
            C 80,66 65,77 54,82
            C 43,77 28,66 28,52
            L 28,26
            Q 28,22 32,22
            Z" />

</vector>
